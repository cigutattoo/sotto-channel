# Railway 后端环境变量模板
# 复制为 .env.railway 或在 Railway 控制台手动设置
# ===== 必需 =====
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_generate_with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CORS_ORIGIN=https://<frontend-domain>.up.railway.app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
UPSTASH_URL=redis://:<password>@<host>:6379
RESEND_API_KEY=re_your_resend_api_key

# ===== 可选 =====
RESEND_FROM_EMAIL=noreply@resend.dev
ADMIN_ALERT_EMAIL=your@email.com
SITE_URL=https://<frontend-domain>.up.railway.app
